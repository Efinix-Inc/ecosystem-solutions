	APB3_REGW(OOB_APB_SLV, APB3_SLV_REG_STREAM_OUT, 0x00 | 0x30 );
	bsp_uDelay(100000);

	APB3_REGW(OOB_APB_SLV, APB3_SLV_REG_STREAM_OUT, 0x00 | 0x70 );
	bsp_uDelay(100000);

/*
