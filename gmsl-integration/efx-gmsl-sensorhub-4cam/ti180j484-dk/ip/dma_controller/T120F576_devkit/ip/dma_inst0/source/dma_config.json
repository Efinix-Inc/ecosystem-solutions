{
    "name": "EfxDMA",
    "efinix_ddr": false,
    "with_sg_bus": true,
    "with_ddr_write_queue": false,
    "with_ddr_read_queue": false,
    "PriorityWidth": 2,
    "weightWidth": 2,
    "ctrl": {
        "asynchronous": true
    },
    "buffer": {
        "bank_count": 1,
        "bank_width": 32,
        "bank_words": 1024
    },
    "read": {
        "address_width": 32,
        "data_width_external": 64,
        "data_width_internal": 32
    },
    "write": {
        "address_width": 32,
        "data_width_external": 64,
        "data_width_internal": 32
    },
    "channels": {
        "c0": {
            "progress_probe": true,
            "direct_ctrl_capable": true,
            "linked_list_capable": true,
            "memory_to_memory": true,
            "outputs": [
                "dat0_o"
            ],
            "half_completion_interrupt": false,
            "self_restart_capable": true,
            "bytes_per_burst": 512,
            "buffer_address": 0,
            "buffer_size": 1024
        },
        "c1": {
            "progress_probe": true,
            "direct_ctrl_capable": true,
            "linked_list_capable": true,
            "memory_to_memory": true,
            "inputs": [
                "dat1_i"
            ],
            "half_completion_interrupt": false,
            "self_restart_capable": true,
            "bytes_per_burst": 512,
            "buffer_address": 1024,
            "buffer_size": 1024
        },
        "c2": {
            "progress_probe": false,
            "direct_ctrl_capable": true,
            "linked_list_capable": false,
            "memory_to_memory": false,
            "outputs": [
                "dat2_o"
            ],
            "half_completion_interrupt": false,
            "self_restart_capable": true,
            "bytes_per_burst": 512,
            "buffer_address": 2048,
            "buffer_size": 1024
        },
        "c3": {
            "progress_probe": false,
            "direct_ctrl_capable": true,
            "linked_list_capable": false,
            "memory_to_memory": false,
            "inputs": [
                "dat3_i"
            ],
            "half_completion_interrupt": false,
            "self_restart_capable": true,
            "bytes_per_burst": 512,
            "buffer_address": 3072,
            "buffer_size": 1024
        }
    },
    "inputs": {
        "dat1_i": {
            "data_width": 32,
            "tid_width": 0,
            "tdest_width": 4,
            "asynchronous": true
        },
        "dat3_i": {
            "data_width": 8,
            "tid_width": 0,
            "tdest_width": 4,
            "asynchronous": true
        }
    },
    "outputs": {
        "dat0_o": {
            "data_width": 32,
            "tid_width": 0,
            "tdest_width": 4,
            "asynchronous": true
        },
        "dat2_o": {
            "data_width": 8,
            "tid_width": 0,
            "tdest_width": 4,
            "asynchronous": true
        }
    }
}