/*------------------------------ 10G Eth Mac -----------------------------*/
apb_master #(
    .ROM_MIF                            ("efx_rom_mif.mem"                  ),
    .ROM_DEPTH                          (5                                  ),
    .RAM_ADDR_W                         (3                                  ),
    .PADDR_WIDTH                        (20                                 ),
    .PDATA_WIDTH                        (32                                 )
) q1_apb_master(    
    .apb_halt_i                         (0                                  ),
    .apb_rom_end_o                      (apb_rom_end_vio                    ),
    .apb_done_o                         (apb_done_vio                       ),
    
    .ram_usr_wren_i                     (ram_usr_wren_vio                   ),
    .ram_usr_addr_i                     (ram_usr_addr_vio                   ),
    .ram_dout_d_o                       (ram_dout_d_vio                     ),
    .ram_dout_a_o                       (ram_dout_a_vio                     ),
    
    .usr_apb_start_i                    (usr_apb_start_vio                  ),
    .usr_apb_write_i                    (usr_apb_write_vio                  ),
    .usr_apb_addr_i                     (usr_apb_addr_vio                   ),
    .usr_apb_pwdata_i                   (usr_apb_pwdata_vio                 ),
    
    .PSEL                               (Q1_USER_APB_PSEL                   ),
    .PWRITE                             (Q1_USER_APB_PWRITE                 ),
    .PENABLE                            (Q1_USER_APB_PENABLE                ),
    .PADDR                              (APB_PADDR                          ),
    .PWDATA                             (Q1_USER_APB_PWDATA                 ),
    .PCLK                               (clk_100m                           ),
    .PRESETn                            (Q1_L2_phy_init_done                ),
    .PRDATA                             (Q1_USER_APB_PRDATA                 ),
    .PREADY                             (Q1_USER_APB_PREADY                 ),
    .PSLVERR                            (0                                  )
);  
assign Q1_USER_APB_PADDR = {3'b110,10'b0,APB_PADDR[10:0]};

/*----------------------- MCU Module ----------------------------*/

xgmac inst_Q1_L2_mac10gbe (
    .mac_reset_n                        ( clk_156m_rstn & clk_50m_rstn      ),
    .mac10gbe_clk                       ( Q1_L2_10gbe_clk                   ),
    .init_clk                           ( clk_50m                           ),
    .init_rst_n                         ( clk_50m_rstn                      ),
    .cnt_rst_n                          ( clk_156m_rstn & clk_50m_rstn      ),  //Assert this port to reset all statistics reporting

//PHY Power Up Interface
    .PMA_CMN_READY                      ( Q1_PMA_CMN_READY                  ),
    .PMA_XCVR_PLLCLK_EN_ACK             ( Q1_L2_PMA_XCVR_PLLCLK_EN_ACK      ),
    .PMA_XCVR_POWER_STATE_ACK           ( Q1_L2_PMA_XCVR_POWER_STATE_ACK    ),
    .PMA_RX_SIGNAL_DETECT               ( Q1_L2_PMA_RX_SIGNAL_DETECT        ),
    .PMA_XCVR_PLLCLK_EN                 ( Q1_L2_PMA_XCVR_PLLCLK_EN          ),
    .PMA_XCVR_POWER_STATE_REQ           ( Q1_L2_PMA_XCVR_POWER_STATE_REQ    ),
    .phy_init_done                      ( Q1_L2_phy_init_done               ),
    
    .tx_axis_mac_tdata                  ( Q1_L2_tx_axis_mac_tdata           ),
    .tx_axis_mac_tvalid                 ( Q1_L2_tx_axis_mac_tvalid          ),
    .tx_axis_mac_tlast                  ( Q1_L2_tx_axis_mac_tlast           ),
    .tx_axis_mac_tkeep                  ( 8'hff                             ),
    .tx_axis_mac_tuser                  ( 1'b0                              ),
    .tx_axis_mac_tready                 ( Q1_L2_tx_axis_mac_tready          ),

    .rx_axis_mac_tdata                  ( Q1_L2_rx_axis_mac_tdata           ),
    .rx_axis_mac_tvalid                 ( Q1_L2_rx_axis_mac_tvalid          ),
