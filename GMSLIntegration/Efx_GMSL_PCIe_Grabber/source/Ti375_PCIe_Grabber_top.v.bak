`else 
   //CSI RX Interface
  //MIPI DPHY RX0
  input  mipi_dphy_rx_inst1_WORD_CLKOUT_HS,
  
  output mipi_dphy_rx_inst1_FORCE_RX_MODE,
  output mipi_dphy_rx_inst1_RESET_N,
